#!/usr/bin/expect -f
set timeout 120
if {[file exists ".env.deploy"]} {
    set f [open ".env.deploy" r]
    while {[gets $f line] >= 0} {
        if {[regexp {^([^#=]+)=(.*)$} $line match key value]} {
            set env($key) $value
        }
    }
    close $f
}

set ip $env(VPS_HOST)
set user $env(VPS_USER)
set password $env(VPS_PASSWORD)
set port $env(VPS_PORT)

spawn ssh -o StrictHostKeyChecking=no -p $port $user@$ip
expect {
    -nocase "assword:" {
        send "$password\r"
        expect "#"
        send "source /opt/disgraf_hub/venv/bin/activate && pip install pyOpenSSL>=23.0.0 lxml>=4.9.0\r"
        expect "#"
        send "pip uninstall -y afip.py\r"
        expect "#"
        send "systemctl restart disgraf-hub && sleep 2 && systemctl status disgraf-hub | head -20\r"
        expect "#"
        send "exit\r"
    }
}
expect eof
