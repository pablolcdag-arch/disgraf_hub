# Archivo de configuración de ejemplo para Disgraf Hub
# Copia este archivo como ".env" y completa los valores antes de arrancar la aplicación.

# Credenciales de Administrador (para entrar a la app)
ADMIN_USERNAME=pablo
ADMIN_PASSWORD=admin

# Credenciales de Ventas (para entrar al cotizador)
SELLER_USERNAME=ventas
SELLER_PASSWORD=ventas

# Configuración de WordPress
WP_URL=https://disgraf.com.ar/wp-json/wp/v2/pages
WP_USER=disgraf
WP_APP_PASSWORD=TU_CONTRASEÑA_DE_APLICACION_AQUI

# Datos de Contacto
WA_NUMBER=5493435133606

# Configuración del Directorio de Datos (opcional, por defecto es ./data)
# DATA_DIR=./data
