#!/usr/bin/expect -f
set timeout 10
set VPS_HOST "149.50.151.121"
set VPS_PORT "5023"
set VPS_USER "root"
set VPS_PASSWORD "Milanga2026-teamo"

spawn ssh -o StrictHostKeyChecking=no -p $VPS_PORT $VPS_USER@$VPS_HOST
expect "password:"
send "$VPS_PASSWORD\r"
expect "#"

send "ls -l /etc/nginx/sites-enabled/\r"
expect "#"
send "cat /etc/nginx/sites-enabled/oficiocarteleria\r"
expect "#"
send "cat /etc/nginx/sites-enabled/disgraf-hub\r"
expect "#"

send "exit\r"
expect eof
