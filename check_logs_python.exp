#!/usr/bin/expect -f
set timeout -1
if {[file exists ".env.deploy"]} {
    set f [open ".env.deploy" r]
    while {[gets $f line] >= 0} {
        if {[regexp {^([^#=]+)=(.*)$} $line match key value]} {
            set env($key) $value
        }
    }
    close $f
}

set ip $env(VPS_HOST)
set user $env(VPS_USER)
set password $env(VPS_PASSWORD)
set port $env(VPS_PORT)

spawn ssh -o StrictHostKeyChecking=no -p $port $user@$ip "/opt/disgraf_hub/venv/bin/python3 -c \"import sqlite3; conn = sqlite3.connect('/opt/disgraf_hub/data/disgraf_hub.db'); print(conn.execute('SELECT * FROM comprobantes ORDER BY id DESC LIMIT 1').fetchall())\" && journalctl -u disgraf-hub -n 200 --no-pager"
expect "password:"
send "$password\r"
expect eof
