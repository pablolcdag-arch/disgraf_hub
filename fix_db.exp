#!/usr/bin/expect -f
set timeout -1
if {[file exists ".env.deploy"]} {
    set f [open ".env.deploy" r]
    while {[gets $f line] >= 0} {
        if {[regexp {^([^#=]+)=(.*)$} $line match key value]} {
            set env($key) $value
        }
    }
    close $f
}

set ip $env(VPS_HOST)
set user $env(VPS_USER)
set password $env(VPS_PASSWORD)
set port $env(VPS_PORT)

spawn ssh -o StrictHostKeyChecking=no -p $port $user@$ip "sqlite3 /opt/disgraf_hub/data/disgraf_hub.db \"UPDATE comprobantes SET impacta_cc = 1 WHERE tipo_comprobante IN ('Factura Electrónica A', 'Factura Electrónica B', 'Nota de Crédito A', 'Nota de Crédito B');\" && journalctl -u disgraf-hub -n 50 --no-pager"
expect "password:"
send "$password\r"
expect eof
