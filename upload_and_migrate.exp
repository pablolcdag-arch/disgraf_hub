#!/usr/bin/expect -f
set timeout 120
if {[file exists ".env.deploy"]} {
    set f [open ".env.deploy" r]
    while {[gets $f line] >= 0} {
        if {[regexp {^([^#=]+)=(.*)$} $line match key value]} {
            set env($key) $value
        }
    }
    close $f
}

set ip $env(VPS_HOST)
set user $env(VPS_USER)
set password $env(VPS_PASSWORD)
set port $env(VPS_PORT)

# Upload migration script
spawn scp -o StrictHostKeyChecking=no -P $port /Users/pablostiefel/Documents/Disgraf_Hub/migrate_comprobante_asociado.py $user@$ip:/opt/disgraf_hub/
expect {
    -nocase "assword:" {
        send "$password\r"
        exp_continue
    }
    eof
}

# Run migration via SSH
spawn ssh -o StrictHostKeyChecking=no -p $port $user@$ip
expect {
    -nocase "assword:" {
        send "$password\r"
        expect "#"
        send "source /opt/disgraf_hub/venv/bin/activate && cd /opt/disgraf_hub && python3 migrate_comprobante_asociado.py\r"
        expect "#"
        send "systemctl restart disgraf-hub && sleep 2 && systemctl is-active disgraf-hub\r"
        expect "#"
        send "exit\r"
    }
}
expect eof
