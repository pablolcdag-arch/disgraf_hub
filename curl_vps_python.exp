#!/usr/bin/expect -f
set timeout -1
if {[file exists ".env.deploy"]} {
    set f [open ".env.deploy" r]
    while {[gets $f line] >= 0} {
        if {[regexp {^([^#=]+)=(.*)$} $line match key value]} {
            set env($key) $value
        }
    }
    close $f
}

set ip $env(VPS_HOST)
set user $env(VPS_USER)
set password $env(VPS_PASSWORD)
set port $env(VPS_PORT)

spawn ssh -o StrictHostKeyChecking=no -p $port $user@$ip "curl -s -X POST http://127.0.0.1:8000/api/ventas/comprobantes -H 'Content-Type: application/json' -d '{\"cliente_id\": \"659\", \"tipo_comprobante\": \"Nota de Crédito A\", \"subtotal\": 8.4, \"total_iva\": 0.0, \"total\": 8.4, \"items\": [{\"producto_id\": \"N/A\", \"descripcion\": \"Productos Prueba\", \"cantidad\": 1.0, \"precio_unitario\": 8.4, \"alicuota_iva\": 0.0, \"subtotal\": 8.4}], \"facturar_afip\": true, \"comprobante_asociado_id\": 8}'"
expect "password:"
send "$password\r"
expect eof
